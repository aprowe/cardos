build/
.pio/
sdkconfig
sdkconfig.old
*.log

# Generated: the app binaries and the header that embeds them. Both come out of
# tools/build_apps.py, and a stale committed copy is worse than no copy -- the
# firmware would carry app binaries built against a different API version.
kernel/app/capp_blobs.h

# A rendered page, produced by python -m server --test. Test output, not source.
page.cpx

# Python bytecode from the tools.
__pycache__/

# The 6x8 font as a TTF, built by server/render/pixelfont.py from kernel/console/
# font6x8.h whenever that header is newer. Generated, and regenerating it is
# a second -- committing it would be a second copy of the font to drift.
server/render/cardos6x8.ttf

# Speech the tests synthesise, and the recording the device sends. Both are
# throwaway audio that happens to land where the tool was run.
*.wav
chatlog_test*/

# written by the Todo host tests in the working directory
todo_test_cache_*.cache
counter_test*
habits_test*
