/* JarScript 3: THE table. apps/jar/jv3.h includes this file with the macros
 * defined to build its tables; server/jar/jarvm3.py reads the same lines with
 * regular expressions at import (nobody retypes them). The semantics are in
 * docs/superpowers/specs/2026-10-14-jarscript3-design.md. Change a line here
 * and both machines change together; the fixtures (tools/
 * make_jarvm3_fixtures.py, test/test_jv3.c) say if they stop agreeing.
 *
 * Keep every entry on one line, in the exact shapes below.
 *
 * J3_OP(code, NAME, operand bytes, "meaning")
 *   Codes are dense from 0. Operands follow the opcode: a "u16" operand is
 *   two bytes, low first; every other operand is one byte. Operand bytes
 *   says how many bytes in all. Values are raw 12.4 fixed point (raw/16).
 */
J3_OP( 0, HALT,   0, "body: park here for good (handler: return)")
J3_OP( 1, RET,    0, "handler: return; body: yield, carry on next tick at the next instruction")
J3_OP( 2, PUSH8,  1, "push the operand (signed byte) as a whole number: raw = operand * 16")
J3_OP( 3, PUSH16, 2, "push the operand (signed 16-bit) as raw")
J3_OP( 4, LDV,    1, "push var K (0..7)")
J3_OP( 5, STV,    1, "pop into var K (0..7)")
J3_OP( 6, LDS,    1, "push sense K")
J3_OP( 7, STP,    1, "pop into sense K, which must be writable (rw)")
J3_OP( 8, ADD,    0, "pop b, pop a, push a + b (saturating)")
J3_OP( 9, SUB,    0, "pop b, pop a, push a - b (saturating)")
J3_OP(10, MUL,    0, "pop b, pop a, push floor(a * b / 16) (saturating)")
J3_OP(11, DIV,    0, "pop b, pop a, push trunc(a * 16 / b) (saturating; 0 when b is 0)")
J3_OP(12, MOD,    0, "pop b, pop a, push a mod b, floored (0 when b is 0)")
J3_OP(13, NEG,    0, "pop a, push -a (saturating)")
J3_OP(14, EQ,     0, "pop b, pop a, push 16 if a == b else 0")
J3_OP(15, NE,     0, "pop b, pop a, push 16 if a != b else 0")
J3_OP(16, LT,     0, "pop b, pop a, push 16 if a < b else 0")
J3_OP(17, LE,     0, "pop b, pop a, push 16 if a <= b else 0")
J3_OP(18, GT,     0, "pop b, pop a, push 16 if a > b else 0")
J3_OP(19, GE,     0, "pop b, pop a, push 16 if a >= b else 0")
J3_OP(20, NOT,    0, "pop a, push 16 if a is 0 else 0")
J3_OP(21, AND,    0, "pop b, pop a, push 16 if both are not 0 else 0")
J3_OP(22, OR,     0, "pop b, pop a, push 16 if either is not 0 else 0")
J3_OP(23, FIELD,  1, "pop an item handle, push its field K (0 for nobody)")
J3_OP(24, CALL,   2, "call function K (first operand) with N arguments (second): pops N, pushes 1")
J3_OP(25, JMP,    2, "jump to u16")
J3_OP(26, JZ,     2, "pop a, jump to u16 if a is 0")
J3_OP(27, JZY,    2, "pop a; if 0, yield and resume at u16 (the condition's start) next tick")
J3_OP(28, RPT,    2, "top of stack is a count: if <= 0 pop it and jump to u16, else subtract 16 and carry on")
J3_OP(29, WAIT,   0, "pop seconds; wait max(1, ticks) ticks (body only)")
J3_OP(30, AWAIT,  0, "body only: while a path, walk or once-anim is under way, stay here and yield")
J3_OP(31, GO,     1, "enter state K (handler: pending, and return)")
J3_OP(32, FRAME,  1, "show frame K (0-based); the anim stops")
J3_OP(33, FRAMEE, 0, "pop N, show frame round(N) - 1 if in range; the anim stops")
J3_OP(34, PLAY,   2, "play anim K (first operand), once if the second is 1")
J3_OP(35, STOP,   0, "no anim")
J3_OP(36, FLAG,   2, "set flag K (first: 0 physics, 1 roll) to the second (0 or 1)")
J3_OP(37, SAY,    2, "pop seconds, then N values (second operand); say string K (first) with them")
J3_OP(38, LOG,    2, "pop N values (second); log string K (first; 255 none) with them")
J3_OP(39, EMIT,   1, "pop N, give off N particles of kind K (0..12)")
J3_OP(40, SWAY,   0, "pop seconds, pop amplitude: sway")
J3_OP(41, SHAKE,  0, "pop seconds: shake")
J3_OP(42, FACE,   0, "pop v: face its sign (0 keeps)")
J3_OP(43, TOWARD, 0, "pop an item: face it")
J3_OP(44, MOVE,   2, "pop arc, pop speed, then the target (x, y | item | nothing); target kind K (first), trait+1 (second, 0 none): a path")
J3_OP(45, WALK,   0, "pop speed, pop dx: walk")
J3_OP(46, HOP,    0, "pop height, pop dx: hop")
J3_OP(47, SIGNAL, 2, "signal number K (first, 1..255); if the second is 1, pop the item it goes to")
J3_OP(48, ACT,    2, "the jar's action K (first); if the second is 1, pop its argument (else 0)")

/* J3_EVENT(number, word, filter, "fires when")
 *   filter: none; every (on every 2s: -- param is the period in ticks);
 *   near (a trait; param is the radius in px, default 24: `within R`);
 *   signal (a name); chime (1..15 minutes, param); or a name group below. */
J3_EVENT( 0, poke,    none,    "the player pokes it")
J3_EVENT( 1, tick,    none,    "every tick (20 a second) -- keep it short")
J3_EVENT( 2, every,   every,   "on a timer: `on every 2s:` (also `every 2s:`)")
J3_EVENT( 3, hit,     none,    "its body struck the soil, the glass or the lid; `impact` is how hard")
J3_EVENT( 4, bump,    none,    "its body met a solid box, or something thrown landed on it: `other`, `impact`")
J3_EVENT( 5, land,    none,    "a move finished; on a perch, `perched` says whose")
J3_EVENT( 6, signal,  signal,  "another item sent `signal NAME`; `other` is the sender")
J3_EVENT( 7, near,    near,    "an item with that trait came within R px (default 24); once per arrival")
J3_EVENT( 8, time,    time,    "dawn, day, dusk or night begins: `on time night:`")
J3_EVENT( 9, weather, weather, "the real weather outside changes: `on weather rainy:`")
J3_EVENT(10, jam,     jam,     "the belt jams or is fixed: `on jam fixed:`")
J3_EVENT(11, gift,    none,    "a parcel enters the jar")
J3_EVENT(12, shipped, none,    "a jar leaves through the cork door")
J3_EVENT(13, chime,   chime,   "every N minutes the jar is open, 1..15 (15 when no N)")
J3_EVENT(14, world,   world,   "a world event begins: `on world ants:`")
J3_EVENT(15, new,     none,    "a new item is put in the jar: `other` is it")
J3_EVENT(16, berry,   none,    "a berry ripens on a bush")

/* J3_SENSE(number, word, rw | ro | jar, "what it reads")
 *   rw: the item's own, and a script may set it (`x = 40`); ro: the item's
 *   own, read only; jar: the world's, read only, asked of the host. */
J3_SENSE( 0, x,         rw,  "my x (centre), px")
J3_SENSE( 1, y,         rw,  "my y (feet), px")
J3_SENSE( 2, vx,        rw,  "my x velocity, px/s")
J3_SENSE( 3, vy,        rw,  "my y velocity, px/s")
J3_SENSE( 4, angle,     rw,  "my rotation, degrees")
J3_SENSE( 5, spin,      rw,  "my turning speed without physics, degrees/s")
J3_SENSE( 6, gravity,   rw,  "px/s^2 (default 160)")
J3_SENSE( 7, bounce,    rw,  "percent kept off a bounce, 0..100 (default 40)")
J3_SENSE( 8, friction,  rw,  "px/s^2 slowing on the ground (default 60)")
J3_SENSE( 9, speed,     ro,  "|velocity|")
J3_SENSE(10, grounded,  ro,  "1 resting on the ground or a solid")
J3_SENSE(11, blocked,   ro,  "1 if the last walk hit something")
J3_SENSE(12, onperch,   ro,  "1 on any perch (the rim too)")
J3_SENSE(13, perched,   ro,  "the item I am perched on (0 none or the rim)")
J3_SENSE(14, facing,    ro,  "1 or -1")
J3_SENSE(15, other,     ro,  "the event's other item")
J3_SENSE(16, impact,    ro,  "how hard the hit or bump was, px/s")
J3_SENSE(17, me,        ro,  "my own handle")
J3_SENSE(18, state,     ro,  "my state's number (a state's name is its number)")
J3_SENSE(19, statetime, ro,  "seconds in this state")
J3_SENSE(20, frame,     ro,  "the frame shown, from 1")
J3_SENSE(21, time,      ro,  "seconds since the jar opened (wraps every 1024)")
J3_SENSE(22, physics,   ro,  "1 while physics is on")
J3_SENSE(23, soil,      ro,  "112, the soil's y")
J3_SENSE(24, jarw,      ro,  "240")
J3_SENSE(25, jarh,      ro,  "135")
J3_SENSE(26, hour,      jar, "the hour of the day, 0..23 (-1 when unknown)")
J3_SENSE(27, daytime,   jar, "dawn, day, dusk, night (0 when unknown)")
J3_SENSE(28, weather,   jar, "the weather (0 when unknown): sunny .. stormy")
J3_SENSE(29, days,      jar, "whole days since I was made")
J3_SENSE(30, berries,   jar, "ripe berries in the jar")
J3_SENSE(31, fed,       jar, "berries I have eaten")
J3_SENSE(32, world,     jar, "the world event going on (0 none): ants, leak, ...")
J3_SENSE(33, zone,      jar, "where I am: garden, works, dock, water, high")
J3_SENSE(34, gift,      jar, "1 if I came as a gift")
J3_SENSE(35, playing,   jar, "1 while the jar's music is on")
J3_SENSE(36, stuck,     jar, "1 while the belt is jammed")
J3_SENSE(37, sulking,   jar, "1 while the snail sulks")

/* J3_FUNC(number, word, least arguments, most, "gives") */
J3_FUNC( 0, random,  2, 2, "a whole number a..b (a fraction if either is one)")
J3_FUNC( 1, chance,  1, 1, "1 with p% odds")
J3_FUNC( 2, pick,    1, 8, "one of the values")
J3_FUNC( 3, abs,     1, 1, "|v|")
J3_FUNC( 4, min,     2, 2, "the smaller")
J3_FUNC( 5, max,     2, 2, "the larger")
J3_FUNC( 6, sign,    1, 1, "-1, 0 or 1")
J3_FUNC( 7, clamp,   3, 3, "v kept within lo..hi")
J3_FUNC( 8, round,   1, 1, "the nearest whole number")
J3_FUNC( 9, floor,   1, 1, "the whole number at or below")
J3_FUNC(10, sqrt,    1, 1, "the square root (0 for v <= 0)")
J3_FUNC(11, sin,     1, 1, "sine of degrees, from a table")
J3_FUNC(12, cos,     1, 1, "cosine of degrees, from a table")
J3_FUNC(13, dist,    1, 2, "distance from me to an item, or to x, y")
J3_FUNC(14, angleto, 1, 1, "direction from me to an item, degrees (0 right, 90 down)")
J3_FUNC(15, find,    1, 2, "the nearest item with a trait (within R): 0 if none")
J3_FUNC(16, count,   1, 1, "how many other items have a trait")
J3_FUNC(17, has,     2, 2, "1 if the item has the trait")

/* J3_FIELD(number, word, "is") -- ITEM.word */
J3_FIELD(0, x,     "its x")
J3_FIELD(1, y,     "its y")
J3_FIELD(2, vx,    "its x velocity")
J3_FIELD(3, vy,    "its y velocity")
J3_FIELD(4, w,     "its width (times its scale)")
J3_FIELD(5, h,     "its height (times its scale)")
J3_FIELD(6, speed, "|its velocity|")
J3_FIELD(7, id,    "its handle (the same number)")

/* J3_TARGET(number, word) -- what MOVE's first operand says */
J3_TARGET(0, xy)
J3_TARGET(1, item)
J3_TARGET(2, perch)
J3_TARGET(3, ground)

/* J3_ACTION(number, word, argument, "what the jar does")
 *   The jar's own verbs, from v2. argument: none, opt (an expression,
 *   default 0), or a name group (sound, glow). */
J3_ACTION( 0, sound, sound, "play a sound (when the jar's sounds are on)")
J3_ACTION( 1, glow,  glow,  "glow on, off, or toggle")
J3_ACTION( 2, eat,   none,  "eat a ripe berry from the nearest bush, if one is in reach; `fed` counts")
J3_ACTION( 3, throw, none,  "fling the nearest small thing in an arc")
J3_ACTION( 4, drop,  none,  "leave a pellet on the soil: the nearest bush grows faster")
J3_ACTION( 5, boost, opt,   "the belt runs fast for N seconds (default 10, at most 30); once a minute")
J3_ACTION( 6, nudge, none,  "a sulking snail gets back to work")
J3_ACTION( 7, quake, none,  "the jar shakes a moment: everything hops")
J3_ACTION( 8, fly,   none,  "my part (a bird, a moth) leaves home and flies about")
J3_ACTION( 9, home,  none,  "my part comes home")

/* J3_PARTICLE(number, word) -- emit's kinds */
J3_PARTICLE(0, leaf)
J3_PARTICLE(1, dust)
J3_PARTICLE(2, feather)
J3_PARTICLE(3, spark)
J3_PARTICLE(4, heart)
J3_PARTICLE(5, note)

/* J3_NAME(group, word, value)
 *   Names a script may write for a number, in any expression, and the event
 *   filters. Traits are bit numbers 0..31 (an item's traits are its record's
 *   tag words; the first 16 are v2's). */
J3_NAME(time,    dawn,    1)
J3_NAME(time,    day,     2)
J3_NAME(time,    dusk,    3)
J3_NAME(time,    night,   4)
J3_NAME(weather, sunny,   1)
J3_NAME(weather, cloudy,  2)
J3_NAME(weather, foggy,   3)
J3_NAME(weather, rainy,   4)
J3_NAME(weather, snowy,   5)
J3_NAME(weather, stormy,  6)
J3_NAME(jam,     jammed,  1)
J3_NAME(jam,     fixed,   2)
J3_NAME(world,   ants,    1)
J3_NAME(world,   leak,    2)
J3_NAME(world,   breeze,  3)
J3_NAME(world,   visitor, 4)
J3_NAME(world,   dark,    5)
J3_NAME(world,   bloom,   6)
J3_NAME(zone,    garden,  0)
J3_NAME(zone,    works,   1)
J3_NAME(zone,    dock,    2)
J3_NAME(zone,    water,   3)
J3_NAME(zone,    high,    4)
J3_NAME(glow,    off,     0)
J3_NAME(glow,    on,      1)
J3_NAME(glow,    toggle,  2)
J3_NAME(sound,   pop,     1)
J3_NAME(sound,   chirp,   2)
J3_NAME(sound,   boing,   3)
J3_NAME(sound,   ding,    4)
J3_NAME(sound,   horn,    5)
J3_NAME(sound,   whoosh,  6)
J3_NAME(sound,   crunch,  7)
J3_NAME(sound,   plop,    8)
J3_NAME(sound,   coin,    9)
J3_NAME(sound,   fizz,    10)
J3_NAME(sound,   clock,   11)
J3_NAME(sound,   splash,  12)
J3_NAME(sound,   bang,    13)
J3_NAME(sound,   tune,    14)
J3_NAME(trait,   food,      0)
J3_NAME(trait,   shiny,     1)
J3_NAME(trait,   fragile,   2)
J3_NAME(trait,   noisy,     3)
J3_NAME(trait,   cosy,      4)
J3_NAME(trait,   light,     5)
J3_NAME(trait,   wet,       6)
J3_NAME(trait,   music,     7)
J3_NAME(trait,   wild,      8)
J3_NAME(trait,   sweet,     9)
J3_NAME(trait,   spooky,    10)
J3_NAME(trait,   soft,      11)
J3_NAME(trait,   big,       12)
J3_NAME(trait,   clockwork, 13)
J3_NAME(trait,   plant,     14)
J3_NAME(trait,   sleepy,    15)
J3_NAME(trait,   critter,   16)
J3_NAME(trait,   bird,      17)
J3_NAME(trait,   bug,       18)
J3_NAME(trait,   fish,      19)
J3_NAME(trait,   flyer,     20)
J3_NAME(trait,   swimmer,   21)
J3_NAME(trait,   climber,   22)
J3_NAME(trait,   roost,     23)
J3_NAME(trait,   nest,      24)
J3_NAME(trait,   shell,     25)
J3_NAME(trait,   stone,     26)
J3_NAME(trait,   wood,      27)
J3_NAME(trait,   seed,      28)
J3_NAME(trait,   flower,    29)
J3_NAME(trait,   prey,      30)
J3_NAME(trait,   hunter,    31)
