/* Lab-only extensions to apps/jarvm.def: what a motion-primitive version of
 * the language (the "extended imperative" candidate) would add. Appended to
 * the real table by labvm.py; never read by the server or the device. */
JV_EVENT(14, stopped, JE_STOPPED, none, "its body came to rest: a roll ran out, a fall landed")
JV_EVENT(15, landed,  JE_LANDED,  none, "the arc it was flying reached its target")
JV_EVENT(16, perched, JE_PERCHED, none, "something landed on one of its perch points")
JV_EVENT(17, hit,     JE_HIT,     none, "its body bounced off a wall or an item")
JV_ACTION(24, body,   JA_BODY,    body,   "physics mode: still, crawl, roll, fall, hang")
JV_ACTION(25, push,   JA_PUSH,    num,    "an impulse along its facing (px/s)")
JV_ACTION(26, swoop,  JA_SWOOP,   target, "fly an arc to a target: nest, perch, friend")
JV_ACTION(27, wobble, JA_WOBBLE,  opt,    "sway on its base for N ticks (0: 8)")
JV_ACTION(28, anim,   JA_ANIM,    num,    "loop frames: first + 4*count + 16*period")
JV_ACTION(29, lib,    JA_LIB,     num,    "run routine N of the flash library (swoop_to, roll, look_around ...)")
JV_SENSE(19, speed,   JSN_SPEED,  "its speed, px/s")
JV_NAME(body,   still, 0, JB_STILL)
JV_NAME(body,   crawl, 1, JB_CRAWL)
JV_NAME(body,   roll,  2, JB_ROLL)
JV_NAME(body,   fall,  3, JB_FALL)
JV_NAME(body,   hang,  4, JB_HANG)
JV_NAME(target, nest,  0, JTG_NEST)
JV_NAME(target, perch, 1, JTG_PERCH)
JV_NAME(target, friend, 2, JTG_FRIEND)
