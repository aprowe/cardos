# CardOS device configuration.

# Route the console to the built-in USB-CDC. The board definition otherwise
# sends it to UART0 pins, which is why "the firmware seems dead" on this board
# is usually a serial problem rather than a crash.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# 8 MB flash, custom partition table (see partitions.csv).
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Required for the app launcher's one-shot guest boot: a guest that never
# validates itself is rolled back to CardOS on the next reset.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# No PSRAM on this board. Say so explicitly so a misconfiguration fails at
# build time rather than as a mysterious boot loop.
# (CONFIG_SPIRAM is not set)

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Bluetooth LE, for the HID-host mouse. NimBLE rather than Bluedroid: roughly
# 30 KB lighter, and every feature Bluedroid adds beyond it is Classic-era,
# which this chip has no radio for.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
# Three: a mouse, a keyboard, and the thermal printer (kernel/drv/btprint.c)
# at the same time. Each one costs a little static RAM for its connection
# state; one was chosen back when only a mouse existed.
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=3
CONFIG_BT_NIMBLE_NVS_PERSIST=y
# Three is the default and it fills up fast: a mouse re-paired a few times
# leaves several identities behind, and once the store is full NimBLE returns
# BLE_HS_ESTORE_CAP and the bond is silently not saved -- so it asks to pair
# again every time.
CONFIG_BT_NIMBLE_MAX_BONDS=8
# nimble_hidh.c -- the whole NimBLE HID *host* implementation -- is guarded by
# BT_NIMBLE_HID_SERVICE. Without it esp_hidh_init links against nothing and the
# build fails on an undefined esp_ble_hidh_init, which does not obviously point
# here.
#
# That option lives under a Services menu that depends on GATT_SERVER, which in
# turn wants the peripheral role -- so a HID *host* has to enable a stack of
# options named after being a *device*. It costs a little memory we do not use.
CONFIG_BT_NIMBLE_GATT_SERVER=y
CONFIG_BT_NIMBLE_HID_SERVICE=y

# Memory protection off, so that code can be executed out of the data heap.
#
# The PMS unit otherwise marks the whole data RAM non-executable, and a loaded
# .capp -- which lives in a heap allocation like any other buffer -- faults on
# its first instruction. It also gates MALLOC_CAP_EXEC out of existence, so the
# allocation cannot even be requested.
#
# The trade is real and worth stating: nothing now stops a stray write from
# corrupting code. CardOS has no MMU, one address space and no process
# isolation anyway, so this removes a guard rail rather than a wall.
CONFIG_ESP_SYSTEM_MEMPROT=n
CONFIG_ESP_SYSTEM_MEMPROT_FEATURE=n

# TLS to Google.
#
# Yahoo's endpoints verified fine and every Google one failed the handshake
# with "Connection failed, sock < 0" -- DNS and TCP were fine, since plain HTTP
# to the same host answered. The difference is the chain: Google Trust Services
# roots are cross-signed (GTS Root R1 under GlobalSign), and the certificate
# bundle refuses a cross-signed chain unless told to follow it.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y

# TLS memory, with both radios up.
#
# Measured: WiFi costs about 53 KB and NimBLE with two HID links most of the
# rest, which left a handshake trying to allocate a 16 KB record buffer, a
# 4 KB write buffer and a peer certificate out of what remained -- and failing
# with nothing more useful to say than "network error".
#
# Dynamic buffers make mbedTLS allocate the record buffers around each record
# rather than holding both for the life of the connection, and drop the peer
# certificate and the parsed config once the handshake is done. The cost is a
# little more malloc traffic per request, which for a device that makes one
# request every few minutes is nothing.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_PEER_CERT=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
