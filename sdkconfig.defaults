# CardOS device configuration.

# Route the console to the built-in USB-CDC. The board definition otherwise
# sends it to UART0 pins, which is why "the firmware seems dead" on this board
# is usually a serial problem rather than a crash.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# 8 MB flash, custom partition table (see partitions.csv).
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Required for the app launcher's one-shot guest boot: a guest that never
# validates itself is rolled back to CardOS on the next reset.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# No PSRAM on this board. Say so explicitly so a misconfiguration fails at
# build time rather than as a mysterious boot loop.
# (CONFIG_SPIRAM is not set)

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Bluetooth LE, for the HID-host mouse. NimBLE rather than Bluedroid: roughly
# 30 KB lighter, and every feature Bluedroid adds beyond it is Classic-era,
# which this chip has no radio for.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_NVS_PERSIST=y
# nimble_hidh.c -- the whole NimBLE HID *host* implementation -- is guarded by
# BT_NIMBLE_HID_SERVICE. Without it esp_hidh_init links against nothing and the
# build fails on an undefined esp_ble_hidh_init, which does not obviously point
# here.
#
# That option lives under a Services menu that depends on GATT_SERVER, which in
# turn wants the peripheral role -- so a HID *host* has to enable a stack of
# options named after being a *device*. It costs a little memory we do not use.
CONFIG_BT_NIMBLE_GATT_SERVER=y
CONFIG_BT_NIMBLE_HID_SERVICE=y
